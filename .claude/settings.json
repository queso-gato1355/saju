{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(saju_env/Scripts/python.exe -m pytest:*)",
      "Bash(../saju_env/Scripts/python.exe -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker images:*)",
      "Bash(docker ps:*)",
      "Bash(npx tsc -b --noEmit:*)",
      "Bash(npm run typecheck:*)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker push:*)",
      "Bash(docker save:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Edit(./saju_env/**)",
      "Write(./saju_env/**)"
    ]
  }
}
