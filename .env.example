# NAS 에서 외부로 여는 포트 (frontend nginx)
WEB_PORT=8080
# cloudflared 를 NAS 호스트(패키지/host 네트워크)로 돌리면 127.0.0.1 권장
WEB_BIND=0.0.0.0
# 백엔드 2차 방어: IP 당 분당 요청 수 / 동시 계산 수
API_RATE_PER_MIN=120
API_MAX_CONCURRENT=4

# 배포할 이미지 태그 (Docker Hub: quesogato3924/saju-backend, saju-frontend)
# latest = 항상 최신 릴리스. 문제가 생기면 1.0.1 처럼 특정 버전으로 고정해 롤백
IMAGE_TAG=latest
